---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.summary}>
  <article class="wrap case">
    <a class="back" href="/#work">← All work</a>
    <p class="eyebrow">{frontmatter.company} · {frontmatter.years}</p>
    <h1>{frontmatter.title}</h1>
    <p class="summary">{frontmatter.summary}</p>
    <dl class="facts">
      <div><dt>Role</dt><dd>{frontmatter.role}</dd></div>
      <div><dt>Stack</dt><dd>{frontmatter.stack}</dd></div>
      <div><dt>Result</dt><dd>{frontmatter.result}</dd></div>
    </dl>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .case { max-width: 46rem; padding-top: 3rem; }
  .back { display: inline-block; font-size: 0.9rem; color: var(--muted); text-decoration: none; margin-bottom: 2.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .summary { font-size: 1.2rem; color: var(--muted); margin: 1.25rem 0 2rem; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 1.25rem 0; border-block: 1px solid var(--line); margin: 0 0 2.5rem; }
  .facts dt { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0.25rem 0 0; font-weight: 500; }
  @media (max-width: 640px) { .facts { grid-template-columns: 1fr; } }
  .prose :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 0.75rem; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: 0.75rem 1.25rem; border-left: 3px solid #e0b100; background: color-mix(in srgb, #e0b100 12%, transparent); border-radius: 0 0.5rem 0.5rem 0; }
  .prose :global(blockquote p) { margin: 0; }
</style>
