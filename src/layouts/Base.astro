---
import { profile } from '../data/profile';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = profile.tagline, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0e1320" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="grid" aria-hidden="true"></canvas>
    {!home && (
      <header class="site-top">
        <div class="wrap top-inner">
          <a class="brand" href="/">JT Porter</a>
          <nav aria-label="Primary">
            <a href="/#now">TimeShareWare</a>
            <a href="/#experience">Experience</a>
            <a href="/resume" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          </nav>
        </div>
      </header>
    )}
    {home ? <slot /> : <main id="main"><slot /></main>}
    {!home && (
      <footer class="site-footer">
        <div class="wrap footer-inner">
          <p>© {new Date().getFullYear()} {profile.name}</p>
          <p>
            <a href={`mailto:${profile.email}`}>Email</a>
            <a href={profile.github}>GitHub</a>
            <a href={profile.linkedin}>LinkedIn</a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import '../scripts/grid.js';
    </script>
  </body>
</html>

<style is:global>
  /* Aliases so the resume, /now and case-study pages share the Matrix palette. */
  :root {
    --ink: var(--fg);
    --surface: var(--panel);
    --serif: var(--display);
    --sans: var(--body);
    --accent-soft: color-mix(in srgb, var(--accent) 14%, transparent);
    --wrap: 68rem;
  }
  body { margin: 0; }
  img { max-width: 100%; height: auto; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .eyebrow { font-family: var(--mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.75rem; }
  .muted { color: var(--muted); }
  .todo { background: color-mix(in srgb, var(--accent) 22%, transparent); padding: 0 0.25em; border-radius: 3px; }
  .skip { position: absolute; left: -9999px; z-index: 30; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--panel); padding: 0.5rem 1rem; }
  main a, .site-footer a { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent); text-underline-offset: 3px; }
  .shell a, .shell main a { text-decoration: none; }

  .site-top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 3.5rem; }
  .brand { font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
  .site-top nav { display: flex; gap: 1.25rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .site-top nav a { color: var(--muted); }
  .site-top nav a:hover, .site-top nav a[aria-current='page'] { color: var(--fg); }
  @media (max-width: 520px) { .site-top nav a:first-child { display: none; } }

  .site-footer { border-top: 1px solid var(--line); margin-top: 6rem; padding-block: 2rem; font-size: 0.9rem; color: var(--muted); }
  .footer-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .footer-inner p { margin: 0; display: flex; gap: 1.25rem; }

  @media print {
    #grid, .site-top, .site-footer, .skip, .no-print { display: none !important; }
    body { background: #fff; color: #000; }
  }
</style>
