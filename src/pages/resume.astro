---
import Base from '../layouts/Base.astro';
import { profile, experience, skills, education, projects } from '../data/profile';
---

<Base title="Resume">
  <article class="wrap resume">
    <p class="no-print actions">
      <span class="muted">This page is print-ready: use “Save as PDF” to get a one-page CV.</span>
      <button onclick="window.print()">Print / Save PDF</button>
    </p>

    <header>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role} · {profile.location}</p>
      <p class="contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.phone && <a href={`tel:${profile.phone.replace(/[^+\d]/g, '')}`}>{profile.phone}</a>}
        <a href="https://jtporter.dev">jtporter.dev</a>
        <a href={profile.linkedin}>linkedin.com/in/jtporter9</a>
        <a href={profile.github}>github.com/jtporter9</a>
      </p>
      <p class="summary">{profile.summary}</p>
    </header>

    <section>
      <h2>Experience</h2>
      {experience.map((job) => (
        <div class="job">
          <div class="job-head">
            <h3>{job.title}, <span>{job.company}</span></h3>
            <span class="dates">{job.start} – {job.end}</span>
          </div>
          <ul>
            {job.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Projects</h2>
      {projects.map((pr) => (
        <p class="project"><strong>{pr.name}</strong> · <a href={pr.url}>{pr.url.replace('https://', '')}</a> · {pr.detail}</p>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {Object.entries(skills).map(([group, list]) => (
          <div><dt>{group}</dt><dd>{list.join(' · ')}</dd></div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Education</h2>
      {education.map((e) => (
        <div class="job">
          <div class="job-head">
            <h3>{e.school}, <span>{e.detail}</span> <span class="muted edu-note">· {e.note}</span></h3>
            <span class="dates">{e.year}</span>
          </div>
        </div>
      ))}
    </section>
  </article>
</Base>

<style>
  .resume { max-width: 50rem; padding-top: 2.5rem; }
  .actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 0.9rem 1.1rem; border: 1px dashed var(--line); border-radius: 0.75rem; font-size: 0.9rem; margin: 0 0 2.5rem; }
  button { font: inherit; font-weight: 500; padding: 0.5rem 1rem; border-radius: 999px; border: 0; background: var(--accent); color: var(--bg); cursor: pointer; }
  h1 { font-size: 2.4rem; }
  .role { margin: 0.2rem 0 0.4rem; font-weight: 500; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.9rem; margin: 0; }
  .summary { margin: 1rem 0 0; color: var(--muted); }
  section { margin-top: 2rem; }
  h2 { font-family: var(--sans); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 0.4rem; margin-bottom: 1rem; }
  .job { margin-bottom: 1.1rem; break-inside: avoid; }
  .job-head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  h3 { font-family: var(--sans); font-size: 1rem; font-weight: 600; }
  h3 span { font-weight: 400; }
  .dates { font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  ul { margin: 0.35rem 0 0; padding-left: 1.1rem; }
  li { margin-bottom: 0.15rem; }
  .note { margin: 0.2rem 0 0; font-size: 0.9rem; }
  .project { margin: 0; }
  .edu-note { font-size: 0.9em; }
  .skills { margin: 0; display: grid; gap: 0.4rem; }
  .skills div { display: grid; grid-template-columns: 12rem 1fr; gap: 1rem; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; }
  @media (max-width: 640px) { .skills div { grid-template-columns: 1fr; gap: 0; } }
  @media print {
    @page { margin: 0.4in 0.55in; }
    :global(body) { font-size: 9pt; line-height: 1.36; }
    .resume { padding: 0; max-width: none; }
    h1 { font-size: 18pt; }
    .summary { margin-top: 0.5rem; }
    section { margin-top: 0.7rem; }
    li { margin-bottom: 0.05rem; }
    ul { margin-top: 0.15rem; }
    h3 { font-size: 10pt; }
    .skills { gap: 0.15rem; }
    .note, .contact, .dates { font-size: 9pt; }
    h2 { color: #000; margin-bottom: 0.5rem; }
    a { text-decoration: none; color: #000; }
    .muted, .summary, .dates { color: #333; }
    .job { margin-bottom: 0.55rem; }
    .todo { background: none; color: #000; }
  }
</style>
